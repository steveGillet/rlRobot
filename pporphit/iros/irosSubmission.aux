\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Near-Base Outreach task evaluation.} The manipulator extends from a configuration near its base (blue marker) to a distant target coordinate (red marker). Transparent overlays depict the collision-free joint-space trajectory generated by RRT-Connect, terminating at the opaque goal configuration. This obstacle-free environment specifically isolates and evaluates a morphology's maximum functional reach and extension efficiency.}}{6}{}\protected@file@percent }
\newlabel{fig:outreachTask}{{5}{6}{}{}{}}
