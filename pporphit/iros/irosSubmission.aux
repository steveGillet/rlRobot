\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Wall Mount task evaluation.} The manipulator, mounted horizontally on the near wall, must navigate to and from the opposing shelf. Faded overlays represent the RRT-generated trajectory. This configuration evaluates a morphology's ability to resist gravity in atypical base orientations while navigating constrained pick-and-place trajectories.}}{4}{}\protected@file@percent }
\newlabel{fig:wallMountTask}{{3}{4}{}{}{}}
\newlabel{fig:shelfTask_1}{{4a}{4}{}{}{}}
\newlabel{sub@fig:shelfTask_1}{{a}{4}{}{}{}}
\newlabel{fig:shelfTask_2}{{4b}{4}{}{}{}}
\newlabel{sub@fig:shelfTask_2}{{b}{4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Shelf task evaluation.} The manipulator navigates around a floating shelf obstacle, moving from a start pose (blue marker) to a goal pose (red marker). Transparent models illustrate the intermediate joint-space trajectory, concluding at the opaque target configuration. This task specifically tests the morphology's capability to maneuver through vertically constrained spaces and perform complex over-and-under reaching motions typical in industrial pick-and-place operations.}}{4}{}\protected@file@percent }
\newlabel{fig:shelfTask}{{4}{4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Near-Base Outreach task evaluation.} The manipulator extends from a configuration near its base (blue marker) to a distant target coordinate (red marker). Transparent overlays depict the collision-free joint-space trajectory generated by RRT-Connect, terminating at the opaque goal configuration. This obstacle-free environment specifically isolates and evaluates a morphology's maximum functional reach and extension efficiency.}}{5}{}\protected@file@percent }
\newlabel{fig:outreachTask}{{5}{5}{}{}{}}
\newlabel{fig:sideToSide_1}{{6a}{5}{}{}{}}
\newlabel{sub@fig:sideToSide_1}{{a}{5}{}{}{}}
\newlabel{fig:sideToSide_2}{{6b}{5}{}{}{}}
\newlabel{sub@fig:sideToSide_2}{{b}{5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Side-to-Side outreach evaluation.} The manipulator navigates from the start pose (blue marker) to the goal pose (red marker) across the workspace. Faded models illustrate the intermediate trajectory states discovered by RRT-Connect. This task evaluates the morphology's ability to maximize lateral reach and avoid collision with its own base.}}{5}{}\protected@file@percent }
\newlabel{fig:sideToSideTask}{{6}{5}{}{}{}}
